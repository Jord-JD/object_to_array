{
  "name": "jord-jd/object_to_array",
  "description": "This PHP package provides an `object_to_array` helper function.",
  "type": "library",
  "authors": [
    {
      "name": "Jordan Hall",
      "email": "jordan@hall05.co.uk"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^7.5 || ^9.6 || ^10.5 || ^11.5 || ^12.0"
  },
  "autoload": {
    "files": [
      "src/Functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "JordJD\\ObjectToArray\\Tests\\": "tests/Unit/"
    }
  },
  "license": "LGPL-3.0-only",
  "require": {
    "php": ">=7.1"
  },
  "replace": {
    "divineomega/object_to_array": "self.version"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "3.x-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "kylekatarnls/update-helper": false
    }
  }
}
